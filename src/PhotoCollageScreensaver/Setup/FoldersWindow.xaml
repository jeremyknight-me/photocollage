<Window x:Class="PhotoCollageScreensaver.Setup.FoldersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Photo Folders"
        Background="{StaticResource DarkGrayBrush}"
        Height="450" Width="480"
        MinHeight="300" MinWidth="380"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Window.Resources>
        <Style TargetType="{x:Type Button}">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="5" />
            <Setter Property="Padding" Value="10, 4" />
            <Setter Property="Foreground" Value="Black" />
        </Style>
    </Window.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Photos are shown from ticked folders. Untick a subfolder to skip it and everything inside it."
                   Foreground="White"
                   FontSize="13"
                   TextWrapping="Wrap"
                   Margin="5,0,5,8" />

        <TreeView x:Name="FolderTree"
                  Grid.Row="1"
                  Margin="5,0"
                  FontSize="13"
                  ItemsSource="{Binding Roots}"
                  SelectedItemChanged="FolderTree_SelectedItemChanged">
            <TreeView.ItemContainerStyle>
                <Style TargetType="{x:Type TreeViewItem}">
                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                </Style>
            </TreeView.ItemContainerStyle>
            <TreeView.ItemTemplate>
                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                    <StackPanel Orientation="Horizontal" Margin="0,1">
                        <CheckBox IsChecked="{Binding IsChecked}"
                                  IsEnabled="{Binding IsEnabled}"
                                  VerticalAlignment="Center"
                                  Margin="0,0,5,0" />
                        <TextBlock x:Name="FolderName" Text="{Binding Name}" VerticalAlignment="Center" />
                    </StackPanel>
                    <HierarchicalDataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsRoot}" Value="True">
                            <Setter TargetName="FolderName" Property="FontWeight" Value="SemiBold" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsChecked}" Value="False">
                            <Setter TargetName="FolderName" Property="Foreground" Value="Gray" />
                        </DataTrigger>
                    </HierarchicalDataTemplate.Triggers>
                </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>

        <DockPanel Grid.Row="2" Margin="0,5,0,0">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <Button Content="Add folder..." Command="{Binding AddFolderCommand}" ToolTip="Add another folder to find photos in." />
                <Button Content="Remove" Command="{Binding RemoveFolderCommand}" ToolTip="Remove the selected top-level folder." />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="OK" IsDefault="True" Click="OkButton_Click" MinWidth="60" />
                <Button Content="Cancel" IsCancel="True" MinWidth="60" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
